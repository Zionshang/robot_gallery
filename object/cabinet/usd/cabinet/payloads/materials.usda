def Scope "Materials"
{
    def Material "mat_0"
    {
        asset inputs:DiffuseTexture = @../Textures/image0.png@
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/mat_0/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/mat_0/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/mat_0/DiffuseTexture.outputs:rgb>
            prepend float inputs:metallic.connect = </Materials/mat_0.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/mat_0.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/mat_0.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }

        def Shader "DiffuseTexture" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            float4 inputs:fallback = (1, 1, 1, 1)
            prepend asset inputs:file.connect = </Materials/mat_0.inputs:DiffuseTexture>
            token inputs:sourceColorSpace = "auto"
            prepend float2 inputs:st.connect = </Materials/mat_0/Primvar_st_float2.outputs:result>
            token inputs:wrapS = "repeat"
            prepend token inputs:wrapS.connect = </Materials/mat_0.inputs:wrapMode>
            token inputs:wrapT = "repeat"
            prepend token inputs:wrapT.connect = </Materials/mat_0.inputs:wrapMode>
            float3 outputs:rgb
        }

        def Shader "Primvar_st_float2" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }

