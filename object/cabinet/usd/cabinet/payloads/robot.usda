#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "link_robot"
    doc = """Generated from Composed Stage of root layer /tmp/tmpvoekw3q9/link_robot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_cabinet_ldfuahr0/usdex_cabinet/link_robot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_cabinet_ldfuahr0/temp_cabinet/cabinet.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "link_robot" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </link_robot/Physics/root_joint>,
        </link_robot/Physics/door_joint_1>,
        </link_robot/Physics/drawer_joint_1>,
        </link_robot/Physics/drawer_joint_2>,
        </link_robot/Physics/drawer_joint_3>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </link_robot/Geometry/base_0>,
        </link_robot/Geometry/base_0/door_1>,
        </link_robot/Geometry/base_0/drawer_1>,
        </link_robot/Geometry/base_0/drawer_2>,
        </link_robot/Geometry/base_0/drawer_3>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_0" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "door_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "drawer_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "drawer_2" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "drawer_3" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "door_joint_1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "drawer_joint_1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "drawer_joint_2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "drawer_joint_3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

